FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package.json ./
COPY tsconfig.json ./
COPY hardhat.config.ts ./

# Install dependencies
RUN npm install

# Copy contract files
COPY contracts/ ./contracts/
COPY scripts/ ./scripts/
COPY test/ ./test/

# Expose Hardhat node port
EXPOSE 8545

# Default command (can be overridden)
CMD ["npx", "hardhat", "node", "--hostname", "0.0.0.0"]
