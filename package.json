{
  "name": "rentinity",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "supabase/functions/*",
    ".accelerator"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel --filter=web --filter=mobile",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "gen:feature": "tsx tools/scripts/create-feature.ts",
    "gen:types": "supabase gen types typescript --schema public > packages/shared/src/db.types.ts",
    "gen:sample-data": "tsx scripts/generate-sample-data.ts",
    "link:blockchain": "mkdir -p apps/web/node_modules/@rentinity/blockchain/dist && cp -r packages/blockchain/dist/* apps/web/node_modules/@rentinity/blockchain/dist/ && cp packages/blockchain/package.json apps/web/node_modules/@rentinity/blockchain/",
    "docker:build": "docker build -t rentinity-web .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "@types/node": "^20.10.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/uuid": "^11.0.0",
    "dotenv": "^16.4.7",
    "fs-extra": "^11.3.1",
    "tsx": "^4.20.4",
    "turbo": "^2.0.9",
    "typescript": "^5.4.0",
    "uuid": "^13.0.0",
    "yaml": "^2.8.1"
  }
}
